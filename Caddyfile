{
	admin off
	auto_https off
}

:80 {
	root * /srv
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
		Content-Security-Policy "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline'; font-src 'self'; connect-src 'self'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'"
		-Server
	}

	# Pulse pindah ke subdomain sendiri. Jalur API lama diarahkan ke sana.
	redir /api/* https://pulse.louvre.my.id{uri} 308

	@html path / /index.html /404.html /robots.txt /sitemap.xml
	header @html Cache-Control "no-cache"
	header /sw.js Cache-Control "no-store"
	@static path /img/* /fonts/* /_astro/*
	header @static Cache-Control "public, max-age=3600"

	@dot path */.*
	respond @dot 404

	file_server {
		hide .*
	}

	handle_errors {
		rewrite * /404.html
		file_server
	}
}
