{
	admin off
	auto_https off
}

:80 {
	root * /srv
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
		Content-Security-Policy "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline' https://static.cloudflareinsights.com; font-src 'self'; connect-src 'self' https://cloudflareinsights.com; base-uri 'none'; form-action 'none'; frame-ancestors 'none'"
		-Server
	}

	# Pengunjung lewat http:// (Cloudflare meneruskan skema asli di Cf-Visitor) -> paksa https.
	@insecure header Cf-Visitor *"scheme":"http"*
	redir @insecure https://{host}{uri} 308

	# Pulse pindah ke subdomain sendiri. Jalur API lama diarahkan ke sana.
	redir /api/* https://pulse.louvre.my.id{uri} 308

	@html path / /index.html /id /id/ /id/index.html /404.html /robots.txt /sitemap.xml
	header @html Cache-Control "no-cache"
	header /sw.js Cache-Control "no-store"
	@static path /img/* /fonts/* /_astro/*
	header @static Cache-Control "public, max-age=31536000, immutable"

	@dot path */.*
	respond @dot 404

	file_server {
		hide .*
	}

	handle_errors {
		rewrite * /404.html
		file_server
	}
}
