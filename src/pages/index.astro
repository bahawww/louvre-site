---
import { apps } from '../data/apps';
import '../styles/site.css';

const title = 'Louvre — workspace pribadi, satu alat demi satu';
const description = 'Louvre mengumpulkan alat yang dibangun sendiri: identitas visual, dasbor server, dan yang berikutnya.';
const logo = apps[0];
// Prototipe: hero + satu bagian koleksi (Logo). Pulse menyusul setelah arah disetujui.
---
<!doctype html>
<html lang="id">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="color-scheme" content="dark" />
    <meta name="theme-color" content="#08080a" />
    <link rel="canonical" href="https://louvre.my.id/" />
    <link rel="icon" href="/img/favicon.ico" sizes="any" />
    <link rel="icon" href="/img/symbol-ink.svg" type="image/svg+xml" media="(prefers-color-scheme: light)" />
    <link rel="icon" href="/img/symbol-white.svg" type="image/svg+xml" media="(prefers-color-scheme: dark)" />
    <link rel="apple-touch-icon" href="/img/apple-touch-icon.png" />
    <link rel="preload" href="/fonts/HankenGrotesk-Variable.woff2" as="font" type="font/woff2" crossorigin />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content="https://louvre.my.id/" />
    <meta property="og:image" content="https://louvre.my.id/img/og-image-v3.png" />
    <meta name="twitter:card" content="summary_large_image" />
    <script is:inline>document.documentElement.classList.add('js')</script>
  </head>
  <body>
    <header class="top">
      <div class="wrap top-in">
        <a href="/" class="mark" aria-label="Louvre, beranda">
          <img src="/img/lockup-white.svg" alt="Louvre" height="24" />
        </a>
        <nav aria-label="Utama">
          <a href="#koleksi">Koleksi</a>
          <a href={logo.url}>Logo</a>
          <a href="https://pulse.louvre.my.id/">Pulse</a>
        </nav>
        <a class="btn btn-ghost btn-sm" href="https://github.com/bahawww">GitHub</a>
      </div>
    </header>

    <main>
      <section class="hero wrap" aria-labelledby="judul">
        <a class="status up" href="#koleksi" style="--i:0">
          <span class="dot pub" aria-hidden="true"></span>
          {apps.length} alat aktif, satu lagi disiapkan
          <span aria-hidden="true">→</span>
        </a>
        <h1 id="judul" class="up" style="--i:1">Workspace pribadi,<br />satu alat demi satu.</h1>
        <p class="lead up" style="--i:2">Louvre mengumpulkan alat yang dibangun sendiri: identitas visual, dasbor server, dan yang berikutnya. Semua tinggal di bawah louvre.my.id.</p>
        <div class="actions up" style="--i:3">
          <a class="btn" href="#koleksi">Lihat koleksi</a>
          <a class="btn btn-ghost" href="https://github.com/bahawww">Kode di GitHub</a>
        </div>
      </section>

      <div class="stage wrap up" style="--i:4">
        <div class="window" data-tilt>
          <div class="chrome" aria-hidden="true">
            <span class="dots"><i></i><i></i><i></i></span>
            <span class="url">{logo.host}</span>
          </div>
          <img src="/img/shot-logo-hero.webp" alt="Tampilan depan logo.louvre.my.id: judul 'Logo yang bisa digambar dari ingatan' dan tombol unduh paket logo" width="2880" height="1800" fetchpriority="high" />
        </div>
      </div>

      <section id="koleksi" class="koleksi wrap" aria-labelledby="koleksi-h">
        <div class="sec-head rv">
          <h2 id="koleksi-h">Koleksi</h2>
          <p>Tiap alat punya domain sendiri, dibangun dan dirawat di mesin yang sama.</p>
        </div>

        <article class="app" aria-labelledby={`a-${logo.id}`}>
          <div class="app-text">
            <img class="app-icon rv" src="/img/symbol-white.svg" alt="" width="40" height="40" />
            <h3 id={`a-${logo.id}`} class="rv">{logo.name}</h3>
            <p class="app-tag rv">{logo.tagline}</p>
            <p class="app-body rv">{logo.body}</p>
            <dl class="facts rv">
              <div><dt>Akses</dt><dd><span class="dot pub" aria-hidden="true"></span>Publik</dd></div>
              <div><dt>Sejak</dt><dd>{logo.year}</dd></div>
              <div><dt>Dibuat dengan</dt><dd>{logo.medium}</dd></div>
              <div><dt>Alamat</dt><dd>{logo.host}</dd></div>
            </dl>
            <a class="more rv" href={logo.url}>Buka {logo.host} <span aria-hidden="true">→</span></a>
          </div>
          <figure class="app-shot rv">
            <img src="/img/shot-logo-ekspor.webp" alt="Panel ekspor di logo.louvre.my.id: pilih versi, lebar, latar, dan format, dengan pratinjau simbol putih" width="2280" height="1425" loading="lazy" decoding="async" />
          </figure>
          <ul class="caps">
            <li class="rv"><strong>Ekspor sesuai kebutuhan</strong><span>PNG, JPG, WebP, atau SVG, dengan lebar dan latar yang dipilih sendiri.</span></li>
            <li class="rv"><strong>Pedoman pemakaian</strong><span>Ruang aman, ukuran minimum, dan contoh yang perlu dihindari.</span></li>
            <li class="rv"><strong>Delapan mockup</strong><span>Kaos, mug, tote, kartu nama, sampai dasbor web, siap diunduh.</span></li>
          </ul>
        </article>
      </section>

      <section class="note wrap" aria-labelledby="note-h">
        <h2 id="note-h">Pulse dan alat berikutnya menyusul.</h2>
        <p>Prototipe: hero dan satu bagian koleksi. Sisanya dibangun setelah arah ini disetujui.</p>
      </section>
    </main>

    <script is:inline>
      (function () {
        var reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        var els = document.querySelectorAll('.rv');
        if (reduce || !('IntersectionObserver' in window)) {
          els.forEach(function (e) { e.classList.add('in'); });
        } else {
          var io = new IntersectionObserver(function (es) {
            es.forEach(function (en) {
              if (en.isIntersecting) { en.target.classList.add('in'); io.unobserve(en.target); }
            });
          }, { rootMargin: '0px 0px -8% 0px' });
          var n = new Map();
          els.forEach(function (e) {
            var p = e.parentElement, k = n.get(p) || 0;
            e.style.setProperty('--d', k * 70 + 'ms');
            n.set(p, k + 1);
            io.observe(e);
          });
        }

        // jendela produk: miring di awal, rata saat di-scroll
        var w = document.querySelector('[data-tilt]');
        if (!w || reduce) return;
        var ticking = false;
        function upd() {
          var r = w.getBoundingClientRect();
          var p = Math.min(1, Math.max(0, 1 - (r.top - window.innerHeight * 0.25) / (window.innerHeight * 0.6)));
          w.style.setProperty('--t', (1 - p).toFixed(3));
          ticking = false;
        }
        window.addEventListener('scroll', function () { if (!ticking) { ticking = true; requestAnimationFrame(upd); } }, { passive: true });
        upd();

        var top = document.querySelector('.top');
        window.addEventListener('scroll', function () { top.classList.toggle('scrolled', window.scrollY > 8); }, { passive: true });
      })();
    </script>
  </body>
</html>
