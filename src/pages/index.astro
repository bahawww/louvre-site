---
import { apps, totalSlots } from '../data/apps';
import '../styles/site.css';

// Sembilan segitiga seperti simbol Louvre: baris berisi 1, 3, 5. Sisi 100, tinggi 86.6.
const H = 86.6;
const tris: { points: string; slot: number }[] = [];
let slot = 0;
for (let r = 1; r <= 3; r++) {
  const ox = (3 - r) * 50;
  const y0 = (r - 1) * H;
  const y1 = r * H;
  for (let k = 0; k < r; k++) {
    // segitiga atas, lalu segitiga bawah di antaranya
    tris.push({ slot: slot++, points: `${ox + k * 100 + 50},${y0} ${ox + k * 100},${y1} ${ox + (k + 1) * 100},${y1}` });
    if (k < r - 1) tris.push({ slot: slot++, points: `${ox + 50 + k * 100},${y0} ${ox + 150 + k * 100},${y0} ${ox + 100 + k * 100},${y1}` });
  }
}
const bySlot = new Map(apps.map((a) => [a.slot, a]));
const filled = apps.length;
const empty = totalSlots - filled;

const title = 'Louvre — workspace dan ekosistem app';
const description = 'Louvre adalah workspace pribadi: identitas, dasbor server, dan alat lain yang dibangun satu per satu.';
const band = [
  { src: '/img/5-dashboard.webp', alt: 'Lockup Louvre pada tampilan dasbor' },
  { src: '/img/1-tshirt.webp', alt: 'Lockup Louvre pada kaos' },
];
---
<!doctype html>
<html lang="id">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="color-scheme" content="light dark" />
    <link rel="canonical" href="https://louvre.my.id/" />
    <link rel="icon" href="/img/favicon.ico" sizes="any" />
    <link rel="icon" href="/img/symbol-ink.svg" type="image/svg+xml" media="(prefers-color-scheme: light)" />
    <link rel="icon" href="/img/symbol-white.svg" type="image/svg+xml" media="(prefers-color-scheme: dark)" />
    <link rel="apple-touch-icon" href="/img/apple-touch-icon.png" />
    <link rel="preload" href="/fonts/HankenGrotesk-Variable.woff2" as="font" type="font/woff2" crossorigin />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content="https://louvre.my.id/" />
    <meta property="og:image" content="https://louvre.my.id/img/og-image-v3.png" />
    <meta name="twitter:card" content="summary_large_image" />
    <script is:inline>document.documentElement.classList.add('js')</script>
  </head>
  <body>
    <header class="top">
      <a href="/" class="mark" aria-label="Louvre, beranda">
        <picture>
          <source media="(prefers-color-scheme: dark)" srcset="/img/lockup-white.svg" />
          <img src="/img/lockup-ink.svg" alt="Louvre" height="30" />
        </picture>
      </a>
      <nav aria-label="Utama">
        <a href="#peta">Peta</a>
        <a href="#app">App</a>
        <a href="#kontak">Kontak</a>
      </nav>
    </header>

    <main>
      <section class="hero" aria-labelledby="judul">
        <h1 id="judul">
          <span class="line"><span class="inner">Satu workspace,</span></span>
          <span class="line"><span class="inner">banyak alat.</span></span>
        </h1>
        <div class="hero-foot">
          <p class="lead">Louvre adalah ekosistem app pribadi: identitas, dasbor server, dan alat lain yang dibangun satu per satu.</p>
          <a class="btn" href="#app">Lihat app</a>
        </div>
      </section>

      <section id="peta" class="peta" aria-labelledby="peta-h">
        <div class="peta-map">
          <svg viewBox="0 0 300 260" role="group" aria-label="Peta ekosistem: sembilan segitiga, dua menyala" class="pyramid">
            {tris.map((t) => {
              const app = bySlot.get(t.slot);
              return app ? (
                <a href={app.url} data-name={app.name} data-info={`${app.tagline} · ${app.host}`} aria-label={`${app.name}: ${app.tagline}`}>
                  <polygon class="tri on" points={t.points} />
                </a>
              ) : (
                <polygon class="tri off" points={t.points} data-name="Slot kosong" data-info="Belum diisi app" />
              );
            })}
          </svg>
          <p class="caption" id="caption" aria-live="polite"><strong>{filled} dari {totalSlots} menyala.</strong> <span id="caption-info">Arahkan ke segitiga untuk melihat isinya.</span></p>
        </div>
        <div class="peta-text">
          <h2 id="peta-h">Satu segitiga, satu app.</h2>
          <p class="statement">Logo Louvre tersusun dari sembilan segitiga. Ekosistemnya mengikuti bentuk yang sama: setiap app mengisi satu segitiga, dan sisanya dibiarkan kosong sampai ada yang layak mengisinya.</p>
          <div class="facts">
            <p>{filled} app menyala</p>
            <p>{empty} slot menunggu</p>
            <p>Sejak 2026</p>
          </div>
        </div>
      </section>

      <section id="app" class="apps" aria-labelledby="app-h">
        <h2 id="app-h">Yang sudah menyala.</h2>
        {apps.map((a, i) => (
          <article class={`app ${i % 2 ? 'flip' : ''}`}>
            <div class="app-pic rv">
              <img src={a.image} alt={a.alt} width="1600" height="1000" loading="lazy" decoding="async" />
            </div>
            <div class="app-text">
              <h3 class="rv">{a.name}</h3>
              <p class="tag rv">{a.tagline}</p>
              <p class="rv">{a.body}</p>
              <p class="access rv"><span class={`dot ${a.access === 'publik' ? 'pub' : 'priv'}`} aria-hidden="true"></span>{a.access === 'publik' ? 'Terbuka untuk siapa saja' : 'Butuh login'}</p>
              <a class="btn rv" href={a.url}>Buka {a.host}</a>
            </div>
          </article>
        ))}
      </section>

      <section class="band" aria-label="Logo Louvre pada beberapa media">
        {band.map((b) => <img class="drift" src={b.src} alt={b.alt} width="1600" height="1000" loading="lazy" decoding="async" />)}
      </section>

      <section class="daftar" aria-labelledby="daftar-h">
        <h2 id="daftar-h">Peta singkat.</h2>
        <ul class="rows">
          {apps.map((a) => (
            <li class="rv"><a href={a.url}><span class="dot on" aria-hidden="true"></span><span class="rn">{a.name}</span><span class="rv2">{a.host}</span></a></li>
          ))}
          <li class="rv muted"><span class="dot off" aria-hidden="true"></span><span class="rn">{empty} slot lain</span><span class="rv2">belum diisi</span></li>
        </ul>
      </section>

      <section id="kontak" class="kontak" aria-labelledby="kontak-h">
        <h2 id="kontak-h">Ada ide app berikutnya?</h2>
        <p class="statement">Kode dan catatan dikerjakan terbuka di GitHub. Mulai dari sana.</p>
        <a class="btn" href="https://github.com/bahawww">github.com/bahawww</a>
      </section>
    </main>

    <footer class="foot">
      <div class="foot-top">
        <p>Louvre workspace</p>
        <p><a href="https://logo.louvre.my.id/">logo.louvre.my.id</a><br /><a href="https://pulse.louvre.my.id/">pulse.louvre.my.id</a></p>
        <a href="#judul">Kembali ke atas</a>
      </div>
      <p class="big" aria-hidden="true">Louvre</p>
    </footer>

    <script is:inline>
      (function () {
        var reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        var els = document.querySelectorAll('.rv');
        if (reduce || !('IntersectionObserver' in window)) {
          els.forEach(function (e) { e.classList.add('in'); });
        } else {
          var io = new IntersectionObserver(function (es) {
            es.forEach(function (en) {
              if (en.isIntersecting) { en.target.classList.add('in'); io.unobserve(en.target); }
            });
          }, { rootMargin: '0px 0px -8% 0px' });
          var sib = new Map();
          els.forEach(function (e) {
            var p = e.parentElement, n = sib.get(p) || 0;
            e.style.setProperty('--d', n * 70 + 'ms');
            sib.set(p, n + 1);
            io.observe(e);
          });
        }
        var cap = document.getElementById('caption-info');
        var def = cap.textContent;
        function show(t) { cap.textContent = t.getAttribute('data-name') + ' · ' + t.getAttribute('data-info'); }
        document.querySelectorAll('.pyramid [data-name]').forEach(function (t) {
          t.addEventListener('pointerenter', function () { show(t); });
          t.addEventListener('focus', function () { show(t); });
          t.addEventListener('pointerleave', function () { cap.textContent = def; });
          t.addEventListener('blur', function () { cap.textContent = def; });
        });
        document.querySelectorAll('.pyramid polygon.off').forEach(function (p) {
          p.addEventListener('click', function () { show(p); });
        });
      })();
    </script>
  </body>
</html>
