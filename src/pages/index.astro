---
import { apps } from '../data/apps';
import '../styles/site.css';

const title = 'Louvre — galeri kecil berisi alat yang dibangun sendiri';
const description = 'Louvre adalah workspace pribadi yang dipajang seperti museum: identitas, dasbor server, dan karya berikutnya.';
// Prototipe: lobi + satu ruang. Ruang lain menyusul setelah arah disetujui.
const rooms = apps.slice(0, 1);
---
<!doctype html>
<html lang="id">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="color-scheme" content="dark" />
    <meta name="theme-color" content="#0b0b0c" />
    <link rel="canonical" href="https://louvre.my.id/" />
    <link rel="icon" href="/img/favicon.ico" sizes="any" />
    <link rel="icon" href="/img/symbol-ink.svg" type="image/svg+xml" media="(prefers-color-scheme: light)" />
    <link rel="icon" href="/img/symbol-white.svg" type="image/svg+xml" media="(prefers-color-scheme: dark)" />
    <link rel="apple-touch-icon" href="/img/apple-touch-icon.png" />
    <link rel="preload" href="/fonts/InstrumentSerif-Regular.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/HankenGrotesk-Variable.woff2" as="font" type="font/woff2" crossorigin />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content="https://louvre.my.id/" />
    <meta property="og:image" content="https://louvre.my.id/img/og-image-v3.png" />
    <meta name="twitter:card" content="summary_large_image" />
    <script is:inline>document.documentElement.classList.add('js')</script>
  </head>
  <body>
    <header class="top">
      <a href="/" class="mark" aria-label="Louvre, beranda">
        <img src="/img/lockup-white.svg" alt="Louvre" height="28" />
      </a>
      <nav aria-label="Utama">
        <a href="#koleksi">Koleksi</a>
        <a href="#buku-tamu">Buku tamu</a>
      </nav>
    </header>

    <main>
      <section class="lobby" aria-labelledby="judul">
        <div class="lightbox" aria-hidden="true"></div>
        <div class="cone" aria-hidden="true"></div>
        <div class="floor" aria-hidden="true"></div>

        <div class="lobby-copy">
          <h1 id="judul">
            <span class="line"><span class="inner">Selamat datang</span></span>
            <span class="line"><span class="inner">di Louvre.</span></span>
          </h1>
          <p class="lead">Galeri kecil berisi alat yang dibangun satu per satu. Lampunya baru dinyalakan, silakan masuk.</p>
          <a class="btn" href="#koleksi">Masuk ke galeri</a>
        </div>

        <figure class="exhibit-0">
          <img class="symbol" src="/img/symbol-white.svg" alt="Simbol Louvre: piramida dari sembilan segitiga" width="160" height="160" />
          <div class="plinth" aria-hidden="true"></div>
        </figure>
      </section>

      <div id="koleksi">
        {rooms.map((a) => (
          <section class="room" aria-labelledby={`r-${a.id}`}>
            <div class="room-cone" aria-hidden="true"></div>
            <h2 id={`r-${a.id}`} class="room-name">{a.room}</h2>

            <figure class="work">
              <div class="frame">
                <img src={a.image} alt={a.alt} width="1200" height="900" loading="lazy" decoding="async" />
              </div>
            </figure>

            <aside class="placard" aria-label={`Keterangan karya ${a.name}`}>
              <p class="p-name">{a.name}</p>
              <p class="p-meta">Louvre, {a.year}<br />{a.medium}</p>
              <p class="p-body">{a.body}</p>
              <p class="p-access">
                <span class={`dot ${a.access === 'publik' ? 'pub' : 'priv'}`} aria-hidden="true"></span>
                {a.access === 'publik' ? 'Terbuka untuk umum' : 'Ruang tertutup, butuh login'}
              </p>
              <a class="btn btn-ink" href={a.url}>Kunjungi {a.host}</a>
              <p class="p-inv">{a.inv}</p>
            </aside>
            <div class="room-floor" aria-hidden="true"></div>
          </section>
        ))}
      </div>

      <section id="buku-tamu" class="guest" aria-labelledby="tamu-h">
        <h2 id="tamu-h">Ruang berikutnya sedang disiapkan.</h2>
        <p class="lead">Prototipe: lobi dan satu ruang. Denah, ruang Pulse, alas kosong, dan buku tamu menyusul setelah arah ini disetujui.</p>
      </section>
    </main>

    <script is:inline>
      (function () {
        var rooms = document.querySelectorAll('.room');
        var reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        if (reduce || !('IntersectionObserver' in window)) {
          rooms.forEach(function (r) { r.classList.add('lit'); });
          return;
        }
        var io = new IntersectionObserver(function (es) {
          es.forEach(function (en) {
            if (en.isIntersecting) { en.target.classList.add('lit'); io.unobserve(en.target); }
          });
        }, { threshold: 0.35 });
        rooms.forEach(function (r) { io.observe(r); });
      })();
    </script>
  </body>
</html>
