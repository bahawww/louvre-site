---
import { apps, type Lang } from '../data/apps';
import { ui } from '../data/i18n';
import PulseMock from './PulseMock.astro';
import AppIcon from './AppIcon.astro';
import '../styles/site.css';

interface Props { lang: Lang }
const { lang } = Astro.props;
const t = ui[lang];
const other: Lang = lang === 'id' ? 'en' : 'id';
const site = 'https://louvre.my.id';
const github = 'https://github.com/bahawww';
const ideaUrl = 'https://github.com/bahawww/louvre-site/issues/new';
---
<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{t.title}</title>
    <meta name="description" content={t.description} />
    <meta name="color-scheme" content="dark light" />
    <link rel="canonical" href={site + t.path} />
    <link rel="alternate" hreflang="en" href={site + ui.en.path} />
    <link rel="alternate" hreflang="id" href={site + ui.id.path} />
    <link rel="alternate" hreflang="x-default" href={site + ui.en.path} />
    <link rel="icon" href="/img/favicon.ico" sizes="any" />
    <link rel="icon" href="/img/symbol-ink.svg" type="image/svg+xml" media="(prefers-color-scheme: light)" />
    <link rel="icon" href="/img/symbol-white.svg" type="image/svg+xml" media="(prefers-color-scheme: dark)" />
    <link rel="apple-touch-icon" href="/img/apple-touch-icon.png" />
    <link rel="preload" href="/fonts/HankenGrotesk-Variable.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="prefetch" href={ui[other].path} />
    <meta property="og:title" content={t.title} />
    <meta property="og:description" content={t.description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={site + t.path} />
    <meta property="og:locale" content={lang === 'id' ? 'id_ID' : 'en_US'} />
    <meta property="og:image" content={site + '/img/og-image-v3.png'} />
    <meta name="twitter:card" content="summary_large_image" />
    <script is:inline>
      // Tema diset sebelum render pertama supaya tidak berkedip.
      (function () {
        var d = document.documentElement, s = null;
        try { s = localStorage.getItem('louvre-theme'); } catch (e) {}
        if (s !== 'light' && s !== 'dark') s = window.matchMedia('(prefers-color-scheme: light)').matches ? 'light' : 'dark';
        d.dataset.theme = s;
        d.classList.add('js');
      })();
    </script>
  </head>
  <body>
    <header class="top">
      <div class="wrap top-in">
        <a href={t.path} class="mark" aria-label={t.home}>
          <img class="only-dark" src="/img/lockup-white.svg" alt="Louvre" height="24" />
          <img class="only-light" src="/img/lockup-ink.svg" alt="Louvre" height="24" />
        </a>
        <nav aria-label={t.navLabel}>
          <span class="nav-pill" aria-hidden="true"></span>
          <a href="#koleksi">{t.collection}</a>
          {apps.map((a) => <a href={`#${a.id}`}>{a.name}</a>)}
        </nav>
        <div class="tools">
          <div class="seg" role="group" aria-label={t.langLabel}>
            <a href={ui.en.path} hreflang="en" lang="en" aria-current={lang === 'en' ? 'true' : undefined}>EN</a>
            <a href={ui.id.path} hreflang="id" lang="id" aria-current={lang === 'id' ? 'true' : undefined}>ID</a>
          </div>
          <button class="theme" type="button" aria-label={t.themeLabel} title={t.themeLabel}>
            <svg class="only-dark" viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><circle cx="12" cy="12" r="4.2" fill="currentColor" /><g stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M12 2.5v2.4M12 19.1v2.4M2.5 12h2.4M19.1 12h2.4M5.3 5.3l1.7 1.7M17 17l1.7 1.7M5.3 18.7 7 17M17 7l1.7-1.7" /></g></svg>
            <svg class="only-light" viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path fill="currentColor" d="M20.2 14.6A8.4 8.4 0 0 1 9.4 3.8a8.4 8.4 0 1 0 10.8 10.8z" /></svg>
          </button>
          <a class="btn btn-ghost btn-sm gh" href={github}>GitHub</a>
        </div>
      </div>
    </header>

    <main>
      <div class="hero-zone">
      <div class="grid-bg" aria-hidden="true"></div>
      <section class="hero wrap" aria-labelledby="judul">
        <h1 id="judul" class="hero-h">{t.h1.map((line, li) => (
          <span class="line">{line.split(' ').map((w, wi) => (
            <><span class="w" style={`--w:${(li ? t.h1[0].split(' ').length : 0) + wi}`}>{w}</span>{' '}</>
          ))}</span>
        ))}</h1>
        <p class="lead up" style="--i:1">{t.lead}</p>
        <div class="actions up" style="--i:2">
          <a class="btn" href="#koleksi">{t.cta}<svg class="arr" viewBox="0 0 16 16" width="16" height="16" aria-hidden="true"><path d="M3 8h10M9 4l4 4-4 4" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg></a>
          <a class="btn btn-ghost" href={github}>{t.code}</a>
        </div>
      </section>

      <div class="stage wrap up" style="--i:3">
        <div class="window spot" data-tilt>
          <div class="chrome" aria-hidden="true">
            <span class="dots"><i></i><i></i><i></i></span>
            <span class="url"><svg class="pl" viewBox="0 0 64 64"><rect class="pl-bg" width="64" height="64" rx="14" /><path class="pl-wave" d="M9 34h10l6-18 9 30 6-12h15" /></svg>pulse.louvre.my.id</span>
          </div>
          <PulseMock lang={lang} view="overview" />
        </div>
        <p class="stage-note">{t.sample}</p>
      </div>
      </div>

      <nav class="strip wrap up" style="--i:4" aria-label={t.apps}>
        {apps.map((a) => (
          <a href={`#${a.id}`} class="strip-item spot">
            <span class={`app-icon sm ic-${a.icon}`} aria-hidden="true"><AppIcon icon={a.icon} /></span>
            <span><strong>{a.name}</strong><small>{a.tagline[lang]}</small></span>
            <svg class="go" viewBox="0 0 16 16" width="16" height="16" aria-hidden="true"><path d="M3 8h10M9 4l4 4-4 4" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
          </a>
        ))}
      </nav>

      <section id="koleksi" class="koleksi wrap" aria-labelledby="koleksi-h">
        <div class="sec-head rv">
          <h2 id="koleksi-h">{t.collection}</h2>
        </div>

        {apps.map((a, i) => (
          <article id={a.id} class={`app spot ${i % 2 ? 'flip' : ''}`} aria-labelledby={`a-${a.id}`}>
            <div class="app-text">
              <span class={`app-icon rv ic-${a.icon}`} aria-hidden="true">
                <AppIcon icon={a.icon} />
              </span>
              <h3 id={`a-${a.id}`} class="rv">{a.name}</h3>
              <p class="app-tag rv">{a.tagline[lang]}</p>
              <p class="app-body rv">{a.body[lang]}</p>
              <dl class="facts rv">
                <div><dt>{t.access}</dt><dd><span class={`dot ${a.access === 'public' ? 'pub' : 'priv'}`} aria-hidden="true"></span>{a.access === 'public' ? t.public : t.login}</dd></div>
                <div><dt>{t.stack}</dt><dd>{a.stack}</dd></div>
              </dl>
              {a.access === 'login' ? (
                <div class="more-row rv">
                  <a class="more" href={a.url}>{t.signIn} {a.host} <span aria-hidden="true">→</span></a>
                  <span class="badge"><svg viewBox="0 0 24 24" width="13" height="13" aria-hidden="true"><rect x="5" y="11" width="14" height="9" rx="2" fill="currentColor"/><path d="M8 11V8a4 4 0 0 1 8 0v3" fill="none" stroke="currentColor" stroke-width="2"/></svg>{t.ownerOnly}</span>
                </div>
              ) : (
                <a class="more rv" href={a.url}>{t.open} {a.host} <span aria-hidden="true">→</span></a>
              )}
            </div>
            <figure class={`app-shot rv ${a.image ? '' : 'has-mock'}`}>
              {a.image ? (
                <>
                  <img class="only-dark" src={a.image.src[lang].dark} alt={a.image.alt[lang]} width={a.image.width} height={a.image.height} loading="lazy" decoding="async" />
                  <img class="only-light" src={a.image.src[lang].light} alt={a.image.alt[lang]} width={a.image.width} height={a.image.height} loading="lazy" decoding="async" />
                </>
              ) : (
                <PulseMock lang={lang} view="terminal" />
              )}
            </figure>
            <ul class="caps">
              {a.caps.map((c) => <li class="rv"><strong>{c.title[lang]}</strong><span>{c.text[lang]}</span></li>)}
            </ul>
          </article>
        ))}
      </section>

      <section class="close wrap" aria-labelledby="close-h">
        <div class="grid-bg" aria-hidden="true"></div>
        <span class="close-mark" aria-hidden="true">
          <img class="only-dark" src="/img/symbol-white.svg" alt="" width="320" height="320" loading="lazy" />
          <img class="only-light" src="/img/symbol-ink.svg" alt="" width="320" height="320" loading="lazy" />
        </span>
        <h2 id="close-h" class="rv">{t.closeH}</h2>
        <p class="lead rv">{t.closeP}</p>
        <div class="actions rv">
          <a class="btn" href={github}>{t.follow}</a>
          <a class="btn btn-ghost" href={ideaUrl}>{t.idea}</a>
        </div>
      </section>
    </main>

    <footer class="foot">
      <div class="wrap">
        <div class="foot-grid">
          <div class="foot-brand">
            <img class="only-dark" src="/img/lockup-white.svg" alt="Louvre" height="22" />
            <img class="only-light" src="/img/lockup-ink.svg" alt="Louvre" height="22" />
            <p>{t.footNote}</p>
          </div>
          <div>
            <p class="foot-h">{t.collection}</p>
            <ul>{apps.map((a) => <li><a href={a.url}>{a.name}</a></li>)}</ul>
          </div>
          <div>
            <p class="foot-h">{t.project}</p>
            <ul>
              <li><a href={github}>GitHub</a></li>
              <li><a href="https://github.com/bahawww/louvre-site">{t.source}</a></li>
              <li><a href={ideaUrl}>{t.idea}</a></li>
            </ul>
          </div>
        </div>
        <div class="foot-bar">
          <p>© 2026 Louvre</p>
          <a href={ui[other].path} hreflang={other} lang={other}>{other === 'en' ? 'English' : 'Bahasa Indonesia'}</a>
        </div>
      </div>
    </footer>

    <a class="totop" href="#judul" aria-label={t.toTop} title={t.toTop}>
      <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true">
        <path d="M12 19V5M5 12l7-7 7 7" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
      </svg>
      <span class="vh">{t.toTop}</span>
    </a>

    <script is:inline>
      (function () {
        var d = document.documentElement;
        var reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        var touch = window.matchMedia('(pointer: coarse)').matches;

        // Pulihkan posisi scroll jika pindah bahasa lewat reload penuh
        var savedY = null;
        try {
          savedY = sessionStorage.getItem('louvre-scroll');
          if (savedY !== null) sessionStorage.removeItem('louvre-scroll');
        } catch (e) {}

        function observeRv() {
          var els = document.querySelectorAll('.rv:not(.in)');
          if (reduce || savedY !== null || !('IntersectionObserver' in window)) {
            els.forEach(function (e) { e.classList.add('in'); });
            return;
          }
          var io = new IntersectionObserver(function (es) {
            es.forEach(function (en) {
              if (en.isIntersecting) { en.target.classList.add('in'); io.unobserve(en.target); }
            });
          }, { rootMargin: '0px 0px -8% 0px' });
          var n = new Map();
          els.forEach(function (e) {
            var p = e.parentElement, k = n.get(p) || 0;
            e.style.setProperty('--d', k * 70 + 'ms');
            n.set(p, k + 1);
            io.observe(e);
          });
        }

        function syncScroll() {
          var top = document.querySelector('.top');
          if (top) top.classList.toggle('scrolled', window.scrollY > 8);
          var tt = document.querySelector('.totop');
          if (tt) tt.classList.toggle('on', window.scrollY > window.innerHeight * 0.7);
          var w = document.querySelector('[data-tilt]');
          if (!w || reduce) return;
          var r = w.getBoundingClientRect();
          var p = Math.min(1, Math.max(0, 1 - (r.top - window.innerHeight * 0.25) / (window.innerHeight * 0.6)));
          w.style.setProperty('--t', (1 - p).toFixed(3));
        }

        // Sama seperti logo.louvre.my.id: crossfade satu halaman lewat View Transitions.
        // Fallback: tema = transisi warna, bahasa = fade teks. Reduced motion = langsung.
        function smooth(kind, apply) {
          if (reduce) { apply(); return; }
          // Di HP (layar sentuh) snapshot View Transition membuat navbar sticky hilang sekejap
          // saat halaman di-scroll: pakai transisi CSS biasa yang tidak melepas navbar.
          if (document.startViewTransition && !touch) {
            d.classList.add('theming');
            document.startViewTransition(apply).finished.finally(function () { d.classList.remove('theming'); });
            return;
          }
          if (kind === 'theme') {
            d.classList.add('tx'); apply();
            setTimeout(function () { d.classList.remove('tx'); }, 420);
          } else {
            d.classList.add('fade');
            setTimeout(function () { apply(); d.classList.remove('fade'); }, 170);
          }
        }

        function swapLang(url, push) {
          var y = window.scrollY;
          fetch(url).then(function (r) {
            if (!r.ok) throw new Error();
            return r.text();
          }).then(function (html) {
            var doc = new DOMParser().parseFromString(html, 'text/html');
            var anchor = currentAnchor();
            smooth('lang', function () { swapDom(doc, url, push, y, anchor); });
          }).catch(function () {
            try { sessionStorage.setItem('louvre-scroll', String(y)); } catch (e) {}
            location.href = url;
          });
        }

        function swapDom(doc, url, push, y, anchor) {
            d.lang = doc.documentElement.lang;
            document.title = doc.title;
            doc.querySelectorAll('.rv').forEach(function (e) { e.classList.add('in'); });
            doc.querySelectorAll('.up, .w').forEach(function (e) { e.style.animation = 'none'; });
            // Contoh Pulse langsung di keadaan akhir: animasi masuknya tidak diulang.
            doc.querySelectorAll('.ui').forEach(function (e) { e.classList.add('live', 'done'); });
            ['header', 'main', 'footer'].forEach(function (tag) {
              var cur = document.querySelector(tag), nxt = doc.querySelector(tag);
              if (cur && nxt) cur.replaceWith(nxt);
            });
            if (push) history.pushState(null, '', url);
            // Teks EN/ID beda panjang: kunci ke bagian yang sedang dilihat, bukan ke angka scroll.
            var a = anchor && document.getElementById(anchor.id);
            var top = a ? window.scrollY + a.getBoundingClientRect().top - anchor.off : y;
            window.scrollTo({ top: top, behavior: 'instant' });
            syncScroll();
            initLive();
        }

        function currentAnchor() {
          var best = null;
          document.querySelectorAll('main [id]').forEach(function (e) {
            var t = e.getBoundingClientRect().top;
            if (t <= window.innerHeight * 0.4 && (!best || t > best.off)) best = { id: e.id, off: t };
          });
          return best;
        }

        document.addEventListener('click', function (ev) {
          var tBtn = ev.target.closest && ev.target.closest('.theme');
          if (tBtn) {
            var n = d.dataset.theme === 'light' ? 'dark' : 'light';
            smooth('theme', function () {
              d.dataset.theme = n;
              try { localStorage.setItem('louvre-theme', n); } catch (e) {}
            });
            return;
          }

          var langA = ev.target.closest && ev.target.closest('a[hreflang]');
          if (langA) {
            var href = langA.getAttribute('href');
            if (href) {
              ev.preventDefault();
              if (href !== location.pathname) swapLang(href, true);
              return;
            }
          }

          var a = ev.target.closest && ev.target.closest('a[href^="#"]');
          if (!a) return;
          var id = a.getAttribute('href').slice(1);
          var t = id ? document.getElementById(id) : null;
          if (!t && id !== 'judul') return;
          ev.preventDefault();
          var beh = reduce ? 'auto' : 'smooth';
          if (id === 'judul') window.scrollTo({ top: 0, behavior: beh });
          else t.scrollIntoView({ behavior: beh });
          if (location.hash) history.replaceState(null, '', location.pathname + location.search);
        });

        window.addEventListener('popstate', function () {
          swapLang(location.pathname, false);
        });

        // ===== contoh Pulse yang hidup: masuk saat terlihat, grafik CPU & log terus berjalan =====
        var liveIO = null;
        function initLive() {
          if (liveIO) liveIO.disconnect();
          var uis = document.querySelectorAll('.ui');
          if (reduce || !('IntersectionObserver' in window)) {
            uis.forEach(function (u) { u.classList.add('live'); });
            return;
          }
          liveIO = new IntersectionObserver(function (es) {
            es.forEach(function (en) {
              en.target.classList.toggle('vis', en.isIntersecting);
              if (en.isIntersecting) en.target.classList.add('live');
            });
          }, { threshold: 0.2 });
          uis.forEach(function (u) { liveIO.observe(u); });
        }

        var plot = new WeakMap(), tick = 0;
        function draw(g, ys, dx) {
          var pts = ys.map(function (y, i) { return (i * dx).toFixed(2) + ',' + y.toFixed(1); }).join(' ');
          g.querySelector('.ui-line').setAttribute('points', pts);
          g.querySelector('.ui-area').setAttribute('points', '0,48 ' + pts + ' ' + ((ys.length - 1) * dx).toFixed(2) + ',48');
        }
        function stepChart(u) {
          var g = u.querySelector('.ui-plot');
          if (!g) return;
          var ys = plot.get(g);
          if (!ys) {
            ys = g.querySelector('.ui-line').getAttribute('points').trim().split(/\s+/).map(function (p) { return parseFloat(p.split(',')[1]); });
            plot.set(g, ys);
          }
          var dx = 100 / (ys.length - 1);
          var next = Math.min(42, Math.max(16, ys[ys.length - 1] + (Math.random() - 0.5) * 13));
          draw(g, ys.concat(next), dx);
          g.style.transition = 'none'; g.style.transform = 'none';
          g.getBoundingClientRect();
          g.style.transition = 'transform 1.4s cubic-bezier(0.4, 0, 0.2, 1)';
          g.style.transform = 'translateX(-' + dx.toFixed(2) + 'px)';
          setTimeout(function () {
            ys.shift(); ys.push(next);
            g.style.transition = 'none'; g.style.transform = 'none';
            draw(g, ys, dx);
            var cpu = Math.round(47 - next), tile = u.querySelector('.ui-tiles .ui-card');
            if (tile) {
              tile.querySelector('b').textContent = cpu + '%';
              tile.querySelector('.ui-bar i').style.width = cpu + '%';
            }
          }, 1450);
        }
        function stepLogs(u) {
          var box = u.querySelector('.ui-logs'), rows = box && box.querySelectorAll('p');
          if (!rows || rows.length < 2) return;
          var first = rows[0], last = rows[rows.length - 1];
          var t = first.querySelector('time').textContent.split(':').map(Number);
          var sec = t[0] * 3600 + t[1] * 60 + t[2] + 6 + Math.floor(Math.random() * 14);
          var pad = function (n) { return (n < 10 ? '0' : '') + n; };
          last.querySelector('time').textContent = pad(Math.floor(sec / 3600) % 24) + ':' + pad(Math.floor(sec / 60) % 60) + ':' + pad(sec % 60);
          last.classList.remove('new');
          first.before(last);
          last.getBoundingClientRect();
          last.classList.add('new');
        }
        if (!reduce) {
          setInterval(function () {
            if (document.hidden) return;
            var u = document.querySelector('.ui-overview.live.vis');
            if (!u) return;
            tick++;
            stepChart(u);
            if (tick % 2 === 0) stepLogs(u);
          }, 2200);
        }

        // ===== sorotan kursor (kartu, jendela, grid hero) & penanda menu =====
        if (window.matchMedia('(hover: hover) and (pointer: fine)').matches && !reduce) {
          document.addEventListener('pointermove', function (ev) {
            var el = ev.target.closest && ev.target.closest('.spot');
            if (el) {
              var r = el.getBoundingClientRect();
              el.style.setProperty('--mx', (ev.clientX - r.left) + 'px');
              el.style.setProperty('--my', (ev.clientY - r.top) + 'px');
            }
            var z = ev.target.closest && ev.target.closest('.hero-zone, .close');
            if (z) {
              var zr = z.getBoundingClientRect();
              z.style.setProperty('--hx', (ev.clientX - zr.left) + 'px');
              z.style.setProperty('--hy', (ev.clientY - zr.top) + 'px');
            }
          }, { passive: true });
          document.addEventListener('pointerover', function (ev) {
            var a = ev.target.closest && ev.target.closest('.top nav a');
            if (!a) return;
            var pill = a.parentElement.querySelector('.nav-pill');
            if (!pill) return;
            var fresh = !pill.classList.contains('on');
            if (fresh) pill.style.transition = 'none';
            pill.style.width = a.offsetWidth + 'px';
            pill.style.height = a.offsetHeight + 'px';
            pill.style.transform = 'translate(' + a.offsetLeft + 'px,' + a.offsetTop + 'px)';
            if (fresh) { pill.getBoundingClientRect(); pill.style.transition = ''; }
            pill.classList.add('on');
          });
          document.addEventListener('pointerout', function (ev) {
            var nav = ev.target.closest && ev.target.closest('.top nav');
            if (!nav || (ev.relatedTarget && nav.contains(ev.relatedTarget))) return;
            var pill = nav.querySelector('.nav-pill');
            if (pill) pill.classList.remove('on');
          });
        }

        if (location.hash) history.replaceState(null, '', location.pathname + location.search);
        initLive();
        observeRv();
        if (savedY !== null) {
          window.scrollTo({ top: parseFloat(savedY) || 0, behavior: 'instant' });
          savedY = null;
        }

        var ticking = false;
        window.addEventListener('scroll', function () {
          if (!ticking) {
            ticking = true;
            requestAnimationFrame(function () { syncScroll(); ticking = false; });
          }
        }, { passive: true });
        syncScroll();
      })();
    </script>
  </body>
</html>
